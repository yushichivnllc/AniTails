# ============================================================================
# AniTails i3-gaps configuration — Midnight Aurora (beautified, minimal, secure)
#
# Policy invariants (never relax):
#   * Tor Browser is the only browser — every keybinding that opens a
#     destination is pinned to anitails-tor-browser.
#   * No screen lock, no suspend, no greeter, no display manager.
#   * The live user `amnesia` has a locked password; nothing here may prompt
#     for one (see docs/I3WM_INTEGRATION.md).
# ============================================================================

set $mod Mod4
set $browser /usr/local/bin/anitails-tor-browser
set $terminal /usr/bin/kitty
set $explorer /usr/bin/dolphin
set $launcher /usr/bin/wofi --allow-images
set $screenshot /usr/local/bin/anitails-screenshot
set $lockscr /usr/local/lib/anitails-i3-desktop/lockscreen-disabled.sh

# --- Geometry -------------------------------------------------------------------
default_border pixel 2
# `smart` hides the edge border when a workspace holds a single window — that is
# what `smart_borders on` used to express. Do NOT add `smart_borders` back: i3
# logs "Both hide_edge_borders and smart_borders was used. Ignoring smart_borders
# as it is deprecated." and silently drops it.
hide_edge_borders smart
smart_gaps on
gaps inner 6
gaps outer 6

# --- Midnight Aurora palette (see docs/I3WM_INTEGRATION.md) ----------------------
client.focused    #38bdf8 #0e1220 #eef1f8 #38bdf8 #0a0d16
client.unfocused  #2a3150 #0d1019 #7c84a0 #1d2338 #2a3150
client.urgent     #fb7185 #161019 #ffe4ea #fb7185 #fb7185
client.placeholder #1d2338 #161a2c #8b93ad #1d2338 #1d2338

# --- Fonts --------------------------------------------------------------------
font pango:Cantarell 10

# --- Workspaces ----------------------------------------------------------------
# i3 syntax: `workspace_layout <default|stacking|tabbed>` (singular, one value).
# `workspace_layouts stacking splitv` is not an i3 directive and made i3 log
# "Expected one of these tokens" + raise a config nagbar.
workspace_layout default
workspace_auto_back_and_forth yes

# --- Bar: i3bar (built into i3) + anitails-i3status -----------------------------
# Waybar is NOT used here: it draws exclusively through gtk-layer-shell, and
# `gtk_layer_is_supported()` is FALSE on X11, so starting it under Xorg produced a
# stray tiled GTK window instead of a bar. `anitails-i3-bar.sh` therefore no-ops
# outside Wayland and this block draws the bar with the same posture banner
# (Tor ●/○, firewall, LUKS, RAM wipe) via /usr/local/bin/anitails-i3status.
# SUPER+Shift+B toggles it (`bar mode toggle`).
bar {
    mode dock
    position top
    height 26
    font pango:Cantarell 10
    status_command /usr/local/bin/anitails-i3status --interval 5
    workspace_buttons yes
    strip_workspace_numbers no
    tray_output none
    colors {
        background          #0a0d16
        statusline          #eef1f8
        separator           #1d2338
        focused_background  #0e1220
        focused_statusline  #38bdf8
        focused_separator   #2a3150
        focused_workspace   #38bdf8 #38bdf8 #0a0d16
        active_workspace    #1d2338 #1d2338 #eef1f8
        inactive_workspace  #0a0d16 #0a0d16 #7c84a0
        urgent_workspace    #f87171 #f87171 #0a0d16
        binding_mode        #38bdf8 #38bdf8 #0a0d16
    }
}

# --- Cursor theme + status bar + notifications ---------------------------------
exec_always --no-startup-id xrdb -merge -quiet "$HOME/.Xresources" >/dev/null 2>&1 || true
exec_always --no-startup-id /usr/local/lib/anitails-i3-bar.sh
exec_always --no-startup-id dunst

# --- Applications -----------------------------------------------------------------
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+Return exec $explorer
bindsym $mod+space exec $launcher --show drun
bindsym $mod+B exec $browser
# Full-screen screenshot (scrot), macOS-style SUPER+SHIFT+4.
bindsym $mod+Shift+4 exec $screenshot
bindsym $mod+S exec /usr/local/bin/anitails-settings
# Hide/show the i3bar (same key the Waybar launcher used to document).
bindsym $mod+Shift+b bar mode toggle
bindsym $mod+L exec $lockscr

# --- Workspaces: 1..9 ------------------------------------------------------------
# SUPER+<n> switches, SUPER+CTRL+<n> moves the focused window there.
# (SUPER+SHIFT+4 is the screenshot key, so window moves cannot use SHIFT.)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# --- Focus / move / kill -----------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+j focus down
bindsym $mod+k focus up
# `move left|right` moves the focused container inside its workspace. The old
# `move container to workspace to the left` was a parse error: i3 expects
# `workspace <name>|number <n>|next|prev|...` after `to workspace`.
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+d kill

# --- Layouts / fullscreen / float ----------------------------------------------------
bindsym $mod+t layout toggle splitv stacking tabbed
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+r mode "resize"

# --- Session ------------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

# --- Resize mode --------------------------------------------------------------------
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym l resize grow width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
