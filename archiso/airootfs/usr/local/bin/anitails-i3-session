#!/usr/bin/env bash
# AniTails — live i3-gaps session launcher (Xorg, no display manager).
#
# There is no display manager any more:
# `getty@tty1` autologins the unprivileged live user `amnesia`;
# /etc/profile.d/99-anitails-session.sh calls this script, which seeds the
# i3 design (verified against MANIFEST.sha256 first) and hands the TTY to Xorg
# through startx.
#
# Failure policy (fail-closed):
#   * dotfile verification failure -> no graphical session at all
#   * normal i3/Xorg exit -> power off (Tails-like: leaving the session ends
#                           the amnesic session)
#   * three crashes in a row -> drop to a shell for diagnostics
set -uo pipefail

export XDG_CURRENT_DESKTOP=i3-gaps
export XDG_SESSION_DESKTOP=i3-gaps
export XDG_SESSION_TYPE=x11
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export PATH="/usr/local/bin:${PATH}"

ANITAILS_SESSION_LAUNCHED=1
export ANITAILS_SESSION_LAUNCHED

log() { printf 'anitails-i3-session: %s\n' "$*" >&2; }

if (( EUID == 0 )); then
    log "refusing to start the graphical session as root"
    exit 1
fi

# 1. Seed the i3 design (verified against MANIFEST.sha256 first).
if ! /usr/local/lib/anitails-i3-seed --quiet; then
    log "dotfile verification failed — starting the tty shell without a desktop"
    log "run 'sudo /usr/local/lib/anitails-i3-seed --check' from a debug shell"
    exit 1
fi

# 2. Make the NVIDIA / Mesa environment computed at boot visible in the journal.
if [[ -r /run/anitails/gpu.env ]]; then
    log "GPU environment: $(tr '\n' ' ' </run/anitails/gpu.env)"
fi

attempt=0
while :; do
    attempt=$((attempt + 1))
    log "starting i3-gaps on Xorg (attempt ${attempt})"

    if ! command -v startx >/dev/null 2>&1; then
        log "startx is not installed — cannot start a graphical session"
        break
    fi

    startx /etc/X11/xinit/anitails-i3.sh
    rc=$?
    log "i3-gaps/Xorg exited with status ${rc}"

    if (( rc == 0 )); then
        log "session ended normally — powering off"
        systemctl poweroff
        exit 0
    fi

    if (( attempt >= 3 )); then
        log "three failed session starts — dropping to a debug shell"
        log "logs: journalctl --user -b ; journalctl -b"
        exec bash -l
    fi

    sleep 2
done

log "session launcher exhausted — staying on the console"
exit 1
