#!/usr/bin/env python3
"""
AniTails — offline seeder for the i3 desktop design.

The ISO carries the i3 design read-only under /usr/share/anitails/i3/. This
script copies them into the live user's $HOME at session start:

  /usr/share/anitails/i3/Configs/**  ->  $HOME/**

Every file is checked against /usr/share/anitails/i3/MANIFEST.sha256 before a
single byte is written, so a corrupted or tampered squashfs image cannot seed a
desktop. All design files are AniTails policy and are refreshed on every boot.

Options:
  --quiet          only report errors
  --force          like the default, but also report refreshes (explicit reset)
  --check          verify the manifest and report what is missing, write nothing
  --home PATH      target home directory (default: $HOME)

Exit codes: 0 ok, 1 verification failed / nothing to do, 2 usage or I/O error.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ANITAILS_I3_DIR exists only so the test suite can point the seeder at the
# repository copy; on the ISO the path is fixed.
VENDOR_DIR = Path(os.environ.get("ANITAILS_I3_DIR", "/usr/share/anitails/i3"))
MANIFEST = VENDOR_DIR / "MANIFEST.sha256"
UPSTREAM = VENDOR_DIR / "UPSTREAM.json"

# All seeded files live under the single Configs/ source root.
SOURCE_ROOT = "Configs"


def log(message: str, *, quiet: bool = False, error: bool = False) -> None:
    stream = sys.stderr if error else sys.stdout
    if error or not quiet:
        print(message, file=stream)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_manifest() -> dict[str, str]:
    if not MANIFEST.is_file():
        raise FileNotFoundError(f"missing dotfile manifest: {MANIFEST}")
    entries: dict[str, str] = {}
    for line in MANIFEST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        digest, sep, rel = line.partition("  ")
        if not sep:
            raise ValueError(f"malformed manifest line: {line!r}")
        entries[rel] = digest
    if not entries:
        raise ValueError(f"empty dotfile manifest: {MANIFEST}")
    return entries


def verify(entries: dict[str, str]) -> list[str]:
    problems: list[str] = []
    for rel, expected in entries.items():
        path = VENDOR_DIR / rel
        if not path.is_file():
            problems.append(f"missing {rel}")
            continue
        actual = sha256_of(path)
        if actual != expected:
            problems.append(f"hash mismatch {rel}: expected {expected[:12]}, got {actual[:12]}")
    return problems


def target_for(rel: str, home: Path) -> Path | None:
    """Map a vendored path to the user's home, or None if it is not seeded."""
    parts = Path(rel).parts
    if len(parts) < 2 or parts[0] != SOURCE_ROOT:
        return None
    return home.joinpath(*parts[1:])


def seed(entries: dict[str, str], home: Path, *, quiet: bool) -> dict[str, object]:
    created: list[str] = []
    for rel in sorted(entries):
        target = target_for(rel, home)
        if target is None:
            continue
        source = VENDOR_DIR / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        tmp = target.with_name(target.name + ".anitails-tmp")
        shutil.copy2(source, tmp)
        os.replace(tmp, target)
        created.append(rel)

    upstream: dict[str, object] = {}
    if UPSTREAM.is_file():
        upstream = json.loads(UPSTREAM.read_text(encoding="utf-8"))

    state_dir = home / ".local/state/anitails"
    state_dir.mkdir(parents=True, exist_ok=True)
    state = {
        "seeded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "stack_version": upstream.get("version", "unknown"),
        "created": len(created),
        "skipped_existing": 0,
    }
    (state_dir / "i3-seed.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")

    # Standard XDG user directories (Pictures is where the wallpaper lives).
    if shutil.which("xdg-user-dirs-update"):
        subprocess.run(
            ["xdg-user-dirs-update"],
            capture_output=True,
            check=False,
            env={**os.environ, "HOME": str(home)},
        )
    for name in ("Documents", "Downloads", "Pictures", "Persistent"):
        (home / name).mkdir(exist_ok=True)

    log(f"anitails-i3-seed: {len(created)} file(s) written", quiet=quiet)
    return state


def main() -> int:
    parser = argparse.ArgumentParser(description="Seed AniTails i3 dotfiles into $HOME")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--home", type=Path, default=Path(os.environ.get("HOME", "/home/amnesia")))
    args = parser.parse_args()

    home: Path = args.home
    if not home.is_dir():
        log(f"anitails-i3-seed: home {home} does not exist", quiet=args.quiet, error=True)
        return 2

    try:
        entries = load_manifest()
    except (OSError, ValueError) as exc:
        log(f"anitails-i3-seed: {exc}", quiet=args.quiet, error=True)
        return 1

    problems = verify(entries)
    if problems:
        for problem in problems:
            log(f"anitails-i3-seed: {problem}", quiet=args.quiet, error=True)
        log("anitails-i3-seed: refusing to seed an unverified design tree", quiet=args.quiet, error=True)
        return 1

    missing = [
        str(target_for(rel, home))
        for rel in entries
        if (target := target_for(rel, home)) is not None and not target.exists()
    ]
    if args.check:
        log(
            f"anitails-i3-seed: {len(entries)} verified file(s), {len(missing)} not yet in {home}",
            quiet=args.quiet,
        )
        for path in missing[:20]:
            log(f"  missing: {path}", quiet=args.quiet)
        return 0

    try:
        seed(entries, home, quiet=args.quiet)
    except OSError as exc:
        log(f"anitails-i3-seed: {exc}", quiet=args.quiet, error=True)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
