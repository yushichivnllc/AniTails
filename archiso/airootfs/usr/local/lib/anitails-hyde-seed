#!/usr/bin/env python3
"""
AniTails — offline seeder for the vendored AniDE/HyDE dotfiles.

The ISO carries the dotfiles read-only under /usr/share/anitails/hyde/. This
script copies them into the live user's $HOME at session start:

  /usr/share/anitails/hyde/Configs/**           -> $HOME/**
  /usr/share/anitails/hyde/overrides/**         -> $HOME/**   (AniTails wins)

Every file is checked against /usr/share/anitails/hyde/MANIFEST.sha256 before a
single byte is written, so a corrupted or tampered squashfs image cannot seed a
desktop. Existing files are never overwritten unless --force is given, which
keeps user edits across a persistent-storage boot.

Options:
  --quiet          only report errors
  --force          overwrite existing files (resets AniTails desktop defaults)
  --check          verify the manifest and report what is missing, write nothing
  --home PATH      target home directory (default: $HOME)

Exit codes: 0 ok, 1 nothing to do / verification failed, 2 usage or I/O error.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ANITAILS_HYDE_DIR only exists so the test suite can point the seeder at the
# repository copy; on the ISO the path is fixed.
VENDOR_DIR = Path(os.environ.get("ANITAILS_HYDE_DIR", "/usr/share/anitails/hyde"))
MANIFEST = VENDOR_DIR / "MANIFEST.sha256"
UPSTREAM = VENDOR_DIR / "UPSTREAM.json"

# Everything the seeder manages is rooted in these two subtrees, mapped onto the
# user's XDG layout exactly like HyDE's own deez-dots manifest does.
SOURCE_ROOTS = ("Configs", "overrides")

# Overrides are AniTails policy and are refreshed on every boot, except the ones
# listed here: they are the user's own entry point into the HyDE config and are
# only seeded when missing (HyDE itself never rewrites them either).
USER_OWNED = {".config/hypr/hyprland.lua"}


def log(message: str, *, quiet: bool = False, error: bool = False) -> None:
    stream = sys.stderr if error else sys.stdout
    if error or not quiet:
        print(message, file=stream)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_manifest() -> dict[str, str]:
    if not MANIFEST.is_file():
        raise FileNotFoundError(f"missing dotfile manifest: {MANIFEST}")
    entries: dict[str, str] = {}
    for line in MANIFEST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        digest, sep, rel = line.partition("  ")
        if not sep:
            raise ValueError(f"malformed manifest line: {line!r}")
        entries[rel] = digest
    if not entries:
        raise ValueError(f"empty dotfile manifest: {MANIFEST}")
    return entries


def verify(entries: dict[str, str]) -> list[str]:
    problems: list[str] = []
    for rel, expected in entries.items():
        path = VENDOR_DIR / rel
        if not path.is_file():
            problems.append(f"missing {rel}")
            continue
        actual = sha256_of(path)
        if actual != expected:
            problems.append(f"hash mismatch {rel}: expected {expected[:12]}, got {actual[:12]}")
    return problems


def target_for(rel: str, home: Path) -> Path | None:
    """Map a vendored path to the user's home, or None if it is not seeded."""
    parts = Path(rel).parts
    if len(parts) < 3 or parts[0] not in SOURCE_ROOTS:
        return None  # LICENSE, MANIFEST.sha256, UPSTREAM.json, ...
    # Drop the leading Configs/ or overrides/ component.
    return home.joinpath(*parts[1:])


def seed(entries: dict[str, str], home: Path, *, force: bool, quiet: bool) -> dict[str, object]:
    created: list[str] = []
    skipped: list[str] = []
    # Configs/ first, then overrides/: the AniTails overrides are policy, not
    # defaults, so they are written even when the upstream file already landed.
    for rel in sorted(entries, key=lambda r: (0 if r.startswith("Configs/") else 1, r)):
        target = target_for(rel, home)
        if target is None:
            continue
        source = VENDOR_DIR / rel
        is_override = rel.startswith("overrides/")
        if target.exists() and not force:
            if not is_override:
                skipped.append(rel)
                continue
            if target.relative_to(home).as_posix() in USER_OWNED:
                # The user's own entry file is only replaced while it is still
                # the pristine upstream copy (i.e. never edited).
                upstream = VENDOR_DIR / rel.replace("overrides/", "Configs/", 1)
                unchanged = upstream.is_file() and sha256_of(target) == sha256_of(upstream)
                if not unchanged:
                    skipped.append(rel)
                    continue
        target.parent.mkdir(parents=True, exist_ok=True)
        tmp = target.with_name(target.name + ".anitails-tmp")
        shutil.copy2(source, tmp)
        os.replace(tmp, target)
        created.append(rel)

    upstream = {}
    if UPSTREAM.is_file():
        upstream = json.loads(UPSTREAM.read_text(encoding="utf-8"))

    state_dir = home / ".local/state/anitails"
    state_dir.mkdir(parents=True, exist_ok=True)
    state = {
        "seeded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "dotfiles_commit": upstream.get("commit", "unknown"),
        "dotfiles_version": upstream.get("dotfiles_version", "unknown"),
        "created": len(created),
        "skipped_existing": len(skipped),
        "force": force,
    }
    (state_dir / "hyde-seed.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")

    # `hyde-shell version` reads this cache; HyDE's own installer normally
    # writes it, and AniTails never runs that installer.
    hyde_state = home / ".local/state/hyde"
    hyde_state.mkdir(parents=True, exist_ok=True)
    (hyde_state / "version").write_text(
        "HYDE_CLONE_PATH='/usr/share/anitails/hyde'\n"
        "HYDE_BRANCH='anitails-vendored'\n"
        f"HYDE_REMOTE='{upstream.get('repository', 'https://github.com/hyprdes/AniDE')}'\n"
        f"HYDE_VERSION='{upstream.get('dotfiles_version', 'unknown')}'\n"
        f"HYDE_VERSION_LAST_CHECKED='{state['seeded_at']}'\n"
        f"HYDE_VERSION_COMMIT_MSG='{upstream.get('commit_subject', '')}'\n"
        f"HYDE_COMMIT_HASH='{upstream.get('commit', 'unknown')}'\n",
        encoding="utf-8",
    )

    # Make sure the executables the keybinds call are actually executable even
    # if the squashfs lost the mode bits.
    for rel in (".local/bin/hyde-shell", ".local/lib/hyde/grimblast"):
        candidate = home / rel
        if candidate.is_file():
            candidate.chmod(candidate.stat().st_mode | 0o111)

    # Standard XDG user directories (Pictures/Wallpapers is where HyDE looks).
    if shutil.which("xdg-user-dirs-update"):
        subprocess.run(
            ["xdg-user-dirs-update"],
            capture_output=True,
            check=False,
            env={**os.environ, "HOME": str(home)},
        )
    for name in ("Documents", "Downloads", "Pictures", "Pictures/Wallpapers", "Persistent"):
        (home / name).mkdir(exist_ok=True)

    log(f"anitails-hyde-seed: {len(created)} file(s) written, {len(skipped)} kept from a previous run", quiet=quiet)
    return state


def main() -> int:
    parser = argparse.ArgumentParser(description="Seed AniTails HyDE dotfiles into $HOME")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--home", type=Path, default=Path(os.environ.get("HOME", "/home/amnesia")))
    args = parser.parse_args()

    home: Path = args.home
    if not home.is_dir():
        log(f"anitails-hyde-seed: home {home} does not exist", quiet=args.quiet, error=True)
        return 2

    try:
        entries = load_manifest()
    except (OSError, ValueError) as exc:
        log(f"anitails-hyde-seed: {exc}", quiet=args.quiet, error=True)
        return 1

    problems = verify(entries)
    if problems:
        for problem in problems:
            log(f"anitails-hyde-seed: {problem}", quiet=args.quiet, error=True)
        log("anitails-hyde-seed: refusing to seed an unverified dotfile tree", quiet=args.quiet, error=True)
        return 1

    missing = [
        str(target_for(rel, home))
        for rel in entries
        if (target := target_for(rel, home)) is not None and not target.exists()
    ]
    if args.check:
        log(
            f"anitails-hyde-seed: {len(entries)} verified file(s), {len(missing)} not yet in {home}",
            quiet=args.quiet,
        )
        for path in missing[:20]:
            log(f"  missing: {path}", quiet=args.quiet)
        return 0

    try:
        seed(entries, home, force=args.force, quiet=args.quiet)
    except OSError as exc:
        log(f"anitails-hyde-seed: {exc}", quiet=args.quiet, error=True)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
